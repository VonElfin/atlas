{
  "name": "atlas",
  "version": "1.0.0",
  "description": "Globo interativo para desktop: relevo, população, clima e mais, sobre imagens de satélite, com terreno 3D.",
  "author": "Marco Ryan",
  "license": "MIT",
  "homepage": "https://github.com/VonElfin/atlas#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VonElfin/atlas.git"
  },
  "bugs": {
    "url": "https://github.com/VonElfin/atlas/issues"
  },
  "keywords": [
    "map",
    "globe",
    "gis",
    "maplibre",
    "neutralinojs",
    "nasa",
    "climate",
    "desktop"
  ],
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "neu run",
    "dev": "neu run -- --window-enable-inspector=true",
    "build": "neu build --release --embed-resources",
    "catalog": "node scripts/build-catalog.mjs",
    "icon": "node scripts/make-icon.mjs",
    "setup": "neu update",
    "installer": "node scripts/build-installer.mjs"
  },
  "devDependencies": {
    "@neutralinojs/neu": "^11.8.0",
    "innosetup": "^6.4.1"
  }
}
