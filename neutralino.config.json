{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "br.tentativa.atlas",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "injectGlobals": true,
  "logging": {
    "enabled": true,
    "writeToLogFile": false
  },
  "nativeAllowList": ["storage.getData", "storage.setData", "os.open"],
  "modes": {
    "window": {
      "title": "Atlas — Globo interativo",
      "width": 1400,
      "height": 900,
      "minWidth": 900,
      "minHeight": 600,
      "center": true,
      "icon": "/resources/icons/appIcon.png",
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true
    },
    "browser": {
      "nativeBlockList": ["os.*"]
    }
  },
  "cli": {
    "binaryName": "atlas",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0"
  }
}
